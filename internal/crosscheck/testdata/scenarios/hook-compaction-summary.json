{
 "name": "hook-compaction-summary",
 "settings": {
  "compaction": {
   "keepRecentTokens": 1
  }
 },
 "extensions": [
  {
   "name": "summarizer",
   "beforeCompact": {
    "summary": "A HOOK SUMMARY"
   }
  }
 ],
 "model": [
  {
   "text": "answer one"
  },
  {
   "text": "answer two"
  },
  {
   "text": "answer three"
  }
 ],
