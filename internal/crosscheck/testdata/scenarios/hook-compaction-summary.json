  {
   "text": "THE SUMMARY"
  }
 ],
 "steps": [
  {
   "submit": {
    "type": "input",
    "content": "first"
   }
  },
  {
   "wait": "settled"
  },
  {
   "submit": {
    "type": "input",
    "content": "second"
   }
  },
  {
   "wait": "settled"
  },
  {
   "compact": "keep it short"
