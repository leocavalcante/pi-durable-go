{
 "name": "abort-during-retry",
 "settings": {
  "retry": {
   "enabled": true,
   "maxRetries": 2,
   "baseDelayMs": 300,
   "maxAgentDelayMs": 1000
  }
 },
 "model": [
  {
   "error": "503 Service Unavailable"
  },
  {
   "text": "never"
  }
 ],
 "steps": [
  {
   "submit": {
    "type": "input",
    "content": "go"
   }
  },
  {
   "wait": "retrying"
  },
  {
   "abort": true
  },
  {
   "wait": "settled"
  }
 ]
}